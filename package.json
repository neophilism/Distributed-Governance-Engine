{
  "name": "@distributed-governance/engine",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs registry/pr-contract.test.mjs",
    "test:fuzz": "node scripts/fuzz.mjs",
    "check": "node scripts/validate-pr-registry.mjs && node scripts/validate-security.mjs && npm test && npm run test:fuzz",
    "demo": "node demo/server.mjs",
    "build": "node scripts/build-editor.mjs",
    "preview": "node scripts/serve-editor.mjs",
    "test:postgres": "node --test tests/identity-postgres.integration.mjs",
    "start": "node server/start.mjs",
    "migrate:identity": "node scripts/migrate-identity.mjs",
    "test:browser": "node --test tests/*.browser.mjs",
    "migrate": "node scripts/migrate-identity.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./legal-structure": "./src/legal-structure.mjs",
    "./editor": "./editor/model.mjs",
    "./draft-cache": "./editor/draft-cache.mjs",
    "./identity": "./server/identity-store.mjs",
    "./oidc": "./server/oidc-login.mjs",
    "./account-http": "./server/account-http.mjs",
    "./application": "./server/application.mjs",
    "./document-store": "./server/document-store.mjs",
    "./document-http": "./server/document-http.mjs",
    "./document-session": "./editor/document-session.mjs",
    "./text-selections": "./src/text-selections.mjs",
    "./legal-proposals": "./src/legal-proposals.mjs",
    "./proposal-store": "./server/proposal-store.mjs",
    "./discussion": "./src/discussion.mjs",
    "./discussion-store": "./server/discussion-store.mjs",
    "./private-crypto": "./src/private-crypto.mjs",
    "./encrypted-draft-cache": "./editor/encrypted-draft-cache.mjs",
    "./public-shared-draft": "./editor/shared-legal-draft.mjs",
    "./realtime-editor": "./editor/realtime-editor.mjs"
  },
  "dependencies": {
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "y-prosemirror": "1.3.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.14.0"
  }
}
